{
  "manifest_version": 3,
  "name": "Agent Websearch Bridge",
  "description": "Browser search and public source extraction for local agents. Operates only tool-created tabs. No screenshots.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Agent Websearch Bridge", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8769"}
}
